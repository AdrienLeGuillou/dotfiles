local({
  r <- getOption("repos")
  r["CRAN"] <- "https://cloud.r-project.org/"
  options(repos = r)
  options(menu.graphics = FALSE)
})

if (interactive()) {
  options(
    max.print = 200,
    browser = "firefox",
    show.signif.stars = FALSE
  )

  q <- function(save="no", ...) {
    quit(save = save, ...)
  }

  message("*** Successfully loaded user's .Rprofile ***")
}
