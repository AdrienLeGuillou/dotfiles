local({
  r <- getOption("repos")
  options(
    repos = c("CRAN" = "https://cloud.r-project.org/"),
    menu.graphics = FALSE
  )
})

if (interactive()) {
  options(
    max.print = 200,
    browser = "firefox",
    show.signif.stars = FALSE
  )

  q <- function(save="no", ...) {
    quit(save = save, ...)
  }

  message("*** Successfully loaded user's .Rprofile ***")
}
